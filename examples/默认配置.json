{
  "schema_version": 2,
  "input": {
    "directory": "",
    "filename": ""
  },
  "design": {
    "operators": 3,
    "operator_names": ["", "", ""],
    "replicates": 3,
    "parts": 10
  },
  "analysis": {
    "method": "crossed_xbarr",
    "percentage_basis": "sd_over_tv",
    "study_multiplier": 6,
    "interaction": "auto",
    "interaction_alpha": 0.05
  },
  "specification": {
    "lsl": null,
    "usl": null,
    "compliance": "strict"
  },
  "generation": {
    "center": null,
    "priority": "center",
    "scale_mode": "auto",
    "reference_tv_sd": null,
    "decimal_places": 4,
    "seed": null,
    "max_attempts": 5000,
    "timeout_seconds": 30
  },
  "target_defaults": {
    "percentage_tolerance_pp": 0.1,
    "ndc_tolerance": 0
  },
  "targets": {
    "EV_pct": null,
    "AV_pct": null,
    "GRR_pct": null,
    "PT_pct": null,
    "ndc": null
  },
  "output": {
    "directory": "",
    "filename": "msa_data",
    "file_type": "csv",
    "encoding": "utf-8-sig",
    "existing_file": "number",
    "format": "default",
    "silent": {
      "csv": false,
      "charts": false,
      "comparison_report": false
    },
    "comparison_report": {
      "format": "pdf",
      "directory": "",
      "filename": "MSA_Comparison"
    },
    "charts": {
      "directory": "",
      "filename": "MSA_Charts",
      "style": "default",
      "format": "png",
      "scope": "current",
      "columns": 2,
      "panel_width": 1800,
      "included": [
        "variance_components",
        "measurement_by_part",
        "measurement_by_operator",
        "range_chart",
        "mean_chart",
        "interaction"
      ]
    },
    "run_order": {
      "mode": "standard",
      "randomize_operators": false,
      "seed": null,
      "store_standard_order": false
    }
  }
}
