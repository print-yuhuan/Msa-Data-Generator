#pragma code_page(65001)
#include <windows.h>
#include "../src/platform/worksheet_ids.h"

MSA_WORKSHEET_DIALOG DIALOGEX 0, 0, 282, 182
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择工作表"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "请选择要导入测量数据的工作表。", -1, 10, 10, 262, 13
    LISTBOX MSA_WORKSHEET_LIST, 10, 28, 262, 120, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "导入", IDOK, 166, 158, 50, 16
    PUSHBUTTON "取消", IDCANCEL, 222, 158, 50, 16
END

MSA_SIX_ROW_DIALOG DIALOGEX 0, 0, 278, 149
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择研究设计"
FONT 10, "Microsoft YaHei UI"
BEGIN
    LTEXT "这 6 行测量数据未标注操作员。请按文件中的行序选择分组。", -1, 12, 10, 254, 16
    AUTORADIOBUTTON "2 人各测 3 次\nA：第 1～3 行　　B：第 4～6 行", MSA_TWO_OPERATORS, 12, 27, 254, 36, BS_MULTILINE | WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "3 人各测 2 次\nA：第 1～2 行　　B：第 3～4 行　　C：第 5～6 行", MSA_THREE_OPERATORS, 12, 68, 254, 36, BS_MULTILINE
    LTEXT "选择仅用于本次导入", -1, 12, 121, 108, 14
    DEFPUSHBUTTON "导入", IDOK, 211, 117, 55, 20, WS_GROUP | WS_DISABLED
    PUSHBUTTON "取消", IDCANCEL, 150, 117, 55, 20
END
