+    if (target == nullptr || (!target->focusable && !target->interactive)) {
+        return;
+    }
+    std::function<bool(const Element&, bool)> available = [&](const Element& node, bool blocked) {
+        blocked = blocked || node.disabled || node.opacity <= 0.0f;
+        if (node.id == requested) {
