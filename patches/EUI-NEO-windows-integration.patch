+// Windows runs an internal message loop during a native border/corner drag.
+// GLFW resize/refresh callbacks still arrive, but the outer application loop
+// cannot draw until that drag ends. Reuse the normal renderer from those
+// callbacks, without allowing a nested frame or leaking another GL context.
+bool frameInProgress = false;
+
+struct WindowFrameScope {
+    GLFWwindow* previousContext = glfwGetCurrentContext();
+    bool previousFrameInProgress = frameInProgress;
+
+    WindowFrameScope() { frameInProgress = true; }
+    ~WindowFrameScope() {
+        if (glfwGetCurrentContext() != previousContext) {
+            glfwMakeContextCurrent(previousContext);
+        }
+        frameInProgress = previousFrameInProgress;
+    }
+};
+
+void requestWindowRepaint(GLFWwindow* window) {
+    auto* state = static_cast<WindowState*>(glfwGetWindowUserPointer(window));
+    if (state == nullptr) {
+        return;
+    }
+    state->paintRequested = true;
+    app::detail::requestFullPaint();
+#ifdef _WIN32
+    if (!frameInProgress && state->repaintImmediately) {
+        WindowFrameScope frame;
+        state->repaintImmediately();
+    }
+#endif
+}
 
